# Neon: use the pooled connection URL for the Vercel app
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=generate-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Groq Console API key for the customer-facing AI chat (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional: override the default Groq chat model
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudinary > Dashboard > Product Environment credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Keep 0 in production; set 1 only when you intentionally want demo records
DB_SEED_DEMO=1
